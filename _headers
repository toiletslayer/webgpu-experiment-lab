/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; worker-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Origin-Agent-Cluster: ?1
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: tools=(self)

